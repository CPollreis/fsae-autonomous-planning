        <mxCell id="apse10" edge="1" parent="1" source="aps_dsms_relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="aps_ebs_actuator_supply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse11" edge="1" parent="1" source="aps_dsms_relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="aps_steering_actuator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse12" edge="1" parent="1" source="aps_rss_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1a5fa8;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.3;" target="aps_shutdown_box" value="RSS 1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse13" edge="1" parent="1" source="aps_rss_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1a5fa8;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;entryX=1;entryY=0.5;" target="hw_go_estop" value="physical E-STOP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse14" edge="1" parent="1" source="aps_rss_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;entryX=1;entryY=0.2;" target="aps_stop_go_note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse_safety_loop" edge="1" parent="1" source="hw_aux_bg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;dashed=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="aps_shutdown_box" value="Safety Loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse_key1" edge="1" parent="1" source="hw_sw1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" target="aps_glvms" value="key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apse_key2" edge="1" parent="1" source="hw_sw2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" target="aps_dsms" value="key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iso_tab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontSize=16;fontStyle=1;" value="Isometric View" vertex="1">
          <mxGeometry height="42" width="500" x="-560" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="iso_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="3D rendered isometric view of the car&#xa;(placeholder &#8212; drop render here)&#xa;&#xa;Include:&#xa;&#8226; Sensors (camera, LiDAR, IMU, wheel speed, steer angle)&#xa;&#8226; Lights&#xa;&#8226; Antenna&#xa;&#8226; EBS&#xa;&#8226; DBS&#xa;&#8226; Aux Panel (DV key + Tractive System button)&#xa;&#8226; Dash&#xa;&#8226; Steering column actuation motor" vertex="1">
          <mxGeometry height="1900" width="500" x="-560" y="10" as="geometry" />
        </mxCell>
      
        <mxCell id="rm_title_1" value="Rules Breakdown by System Section&#10;(FSAE/FSG Driverless rules mapped onto the Software Pipeline / HW Setup / Actuator Power Supply / Isometric View tabs above, and onto the Mech + Electrical &quot;brain dump&quot; system categories)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2000" width="1750" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rm_hdr_2" value="MECHANICAL — DT.2.x / DT.3.x  (rules digest: mechanical_requirements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;fontColor=#ffffff;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2070" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rm_hdr_3" value="ELECTRICAL — DT.1.x / DT.4 / DO.2.2  (rules digest: electrical_requirements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;fontColor=#ffffff;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2070" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rm_hdr_4" value="SOFTWARE — DO.1.x / DD.x  (rules digest: software_requirements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1baf7a;fontColor=#ffffff;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2070" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rm_hdr_5" value="GATING &amp; INSPECTION — IN.3.x / DI.2 / DO.1.3  (rules digest: gating_inspections)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7b4fa6;fontColor=#ffffff;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-520" y="2070" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_6" value="DT.3.1 — Driverless System Brake (DSB)&#10;&#10;Required. Tractive System is NOT a brake system. All parts and mountings inside Rollover Protection Envelope. Manual braking must always remain possible. May be part of the hydraulic brake system.&#10;&#10;Maps to: ABS box (mech img: EBS + DSB) · HW Setup &quot;Brake + Accel&quot; actuator · Monoboard State Machine (brake monitoring)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2130" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_7" value="DT.3.1.2 — Deactivation Points&#10;&#10;Max two. Inside the DT.2.3 volume, near the DSMS or on top of vehicle between Front Bulkhead and Front Hoop near centerline. Near each other, protected from cone strikes, marked &#x27;Brake Release&#x27;, red handle, must work with NO electrical power, max two simple push/pull/turn actions with the order shown next to them.&#10;&#10;Maps to: ABS/DSB deactivation points · Actuator Power Supply Schematic: DSMS box (release must sit near it)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2300" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_8" value="DT.3.2.1 — EBS energy storage&#10;&#10;EBS must ONLY use passive systems with mechanical energy storage. Directly supplied by GLVMS, DSMS, Remote Stop Relay and EBS Relay with no delay.&#10;&#10;Maps to: ABS/EBS · Actuator Power Supply chain: GLVMS -&gt; DSMS -&gt; EBS Control -&gt; EBS Actuator Supply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2470" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_9" value="DT.3.2.5 — EBS performance&#10;&#10;Reaction time (SDC open to start of deceleration) &lt;= 200 ms. Average deceleration &gt; 10 m/s^2 dry. On single failure should still achieve at least half performance. Must stay in stable driving condition while decelerating.&#10;&#10;Maps to: ABS/EBS · Gating: EBS Test (DI.2, see GATING column)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2640" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_10" value="DT.2.1 — Steering actuation&#10;&#10;Manual steering must be possible with DSMS Off with no other steps. Steering actuation only possible when Ready to Drive. Steering may stay active during an Emergency Brake Maneuver while moving.&#10;&#10;Maps to: ASS box (mech img: Autonomous Steering System) · HW Setup &quot;Steer&#x27;s (Steering Actuator)&quot; · Actuator Power Supply: Steering Actuator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2810" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_11" value="DT.2.2 — Actuator decoupling&#10;&#10;If actuators are disconnected for Manual Mode: no parts removed, mechanism must not block manual operation in any position, must lock securely in both positions.&#10;&#10;Maps to: ASS box: &quot;Steering column integration w/ motor&quot; · Steering Actuator block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="2980" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_12" value="DT.2.3 — Sensor and electronics mounting&#10;&#10;All DV components including sensors and cameras must sit inside the volume formed by the outside surfaces of chassis and tires, or in the permitted Aerodynamic Device locations (T.7.5-T.7.7).&#10;&#10;Maps to: ASM box (mech img: Autonomous Sensor Mounting) · Isometric View tab sensor list · HW Setup sensor inputs (IMU, steer ang, wheel speeds, camera, LiDAR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a5aa8;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="3150" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_13" value="DT.1.1 — Driverless System Master Switch (DSMS)&#10;&#10;Meets T.9.3 config/location. Direct acting, not through relay or logic. Centered in a fully blue circular area &gt;50 mm diameter, labeled &#x27;DS&#x27;, lockout/tagout capable in OFF. When OFF: no steering/braking/propulsion actuation, car pushable, car drivable in Manual Mode. Sensors and processing may still run.&#10;&#10;Maps to: Electrical img: &quot;Controls &amp; Indicators&quot; - DSMS · Actuator Power Supply Schematic: DSMS box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2130" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_14" value="DT.1.2 — Tractive System Activation Button&#10;&#10;Located near the Tractive System Master Switch. Puts car in TS Active from outside the vehicle. Does nothing when DSMS is OFF.&#10;&#10;Maps to: Electrical img: &quot;Controls &amp; Indicators&quot; - TSA button (annotated &quot;need DSMS iirc&quot;) · Aux Panel (HW Setup)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2300" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_15" value="DT.1.3 — Driverless System Status Indicators (DSSI)&#10;&#10;THREE indicators: one each side behind cockpit (160 mm below Main Hoop top to 600 mm above ground), one at rear on centerline (160 mm below Main Hoop top to 100 mm above brake light). At least one visible from any angle at 1.6 m height within 3 m radius. Black background, &gt;=15 cm^2 shining surface. Bare LEDs &lt;=20 mm apart; single LED line &gt;=150 mm long. No other function.&#10;&#10;Maps to: Electrical img: &quot;Controls &amp; Indicators&quot; - DSSI · HW Setup: new &quot;DSSI&quot; block, fed from CAN1 state message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2470" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_16" value="DO.1.1.3 — DSSI states&#10;&#10;Off=Off, Ready=Yellow Continuous, Driving=Yellow Flashing, Finished=Blue Continuous, Emergency=Blue Flashing.&#10;&#10;Maps to: Same as DT.1.3 — HW Setup: &quot;DSSI&quot; block (state colors are the CAN1 &quot;state&quot; signal driving it)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2640" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_17" value="DT.1.4 — Driverless Alert Sound&#10;&#10;On Emergency status: intermittent tone 1-5 Hz at 50% duty, 80-90 dBA fast weighting within 2 m radius, for 8-10 s.&#10;&#10;Maps to: Electrical img: &quot;Controls &amp; Indicators&quot; - DV Alert Sound · HW Setup: new &quot;Driverless Alert Sound&quot; block, fed from CAN1 on Emergency status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2810" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_18" value="DO.1.4 — Driverless Mission Indicator&#10;&#10;Shows selected mission, easily readable, on the dash or near the DSMS.&#10;&#10;Maps to: HW Setup: &quot;DASH - ASM Selection&quot; mission buttons 1-9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="2980" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_19" value="DT.3.3 / RS — Remote Stop System (RSS)&#10;&#10;MANDATED HARDWARE: Gross-Funk GmbH control box + vehicle module, latest revision with E-Key. SIL3 (EN61508) certified, 25 mW, 12-24 V (0.26 A @ 12 V), 450 g, IP20 receiver / IP65 sender. Vehicle module has an NO relay in the shutdown circuit, opens on shutdown, signal loss, and power loss, 4 A max. CANopen at Node-ID 0x011, 500 kbps at competition, set by DIP switches. Antenna must be unobstructed. LONG-LEAD PROCUREMENT ITEM.&#10;&#10;Maps to: Electrical img: &quot;RES&quot; box (&quot;Safety loop addition w/ relay&quot;) · HW Setup: RSS label + Safety Loop · Actuator Power Supply: RSS Control Box, RSS 1, RSS Bypass Relay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="3150" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_20" value="DT.4 — Shutdown circuit additions&#10;&#10;Three additions: (1) Driverless System Relay, normally open permissive, closes when DS checks pass. (2) Remote Stop Relay, in series with shutdown buttons, bypassed by a normally-closed relay in Manual Mode; bypass relay directly supplied by DSMS with safety-certified forcibly guided or mirrored NO contact in series with DSMS. (3) EBS Relay, fail-open, coil in parallel with the Isolation Relays.&#10;&#10;Maps to: Actuator Power Supply Schematic: Shutdown Circuit box, DSMS Relay, RSS Bypass Relay, EBS Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="3320" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_21" value="DO.2.2 — Wireless restrictions&#10;&#10;Between start and finish line: no wireless TO the vehicle. One-way telemetry FROM the vehicle is allowed. The Remote Stop Control Box is the only device that may command the car.&#10;&#10;Maps to: Actuator Power Supply: RSS Control Box + Vehicle Module (only device allowed to command car) · Isometric View: Antenna" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b84f24;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="3490" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_22" value="DO.1.2.1 — Required missions&#10;&#10;Must implement at minimum: Inspection, Manual Driving, EBS Test, Acceleration, Skidpad, Autocross. Trackdrive optional for 2026, expected later.&#10;&#10;Maps to: HW Setup: &quot;DASH - ASM Selection&quot; buttons 1-9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2130" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_23" value="DO.1.2.2 — Mission selection&#10;&#10;Must not use an external device. Needs onboard selection (dash/rotary switch).&#10;&#10;Maps to: Same dash buttons — must be onboard, no external device" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2300" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_24" value="DT.3.1.3 — Startup check and monitoring&#10;&#10;A Startup Check must prove the DSB builds brake pressure as expected before Ready is possible. After that, DSB and its signals must be CONTINUOUSLY monitored for failures.&#10;&#10;Maps to: Monoboard State Machine · DSB (&quot;Brake + Accel&quot; actuator)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2470" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_25" value="DT.3.2.3 — Safe State logic&#10;&#10;Go to Safe State if EBS functionality cannot be ensured, or if one additional single point of failure would cause total loss of braking. Safe State = standstill + brakes engaged + open shutdown circuit.&#10;&#10;Maps to: Monoboard State Machine · EBS Control (Actuator Power Supply Schematic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2640" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_26" value="DO.1.1 — State machine&#10;&#10;Driverless System Status determined by the DO.1.1.1 flowchart: Off, Ready, Driving, Finished, Emergency.&#10;&#10;Maps to: HW Setup: &quot;Monoboard State Machine&quot; block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2810" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_27" value="DD.1.2.4 — No prior map&#10;&#10;No map data is given. No artificial landmarks or beacons may be placed. Track must be discovered online from cones alone.&#10;&#10;Maps to: Software Pipeline tab: slam_ws, &quot;Initial Pose Guess&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="2980" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_28" value="DD.3.2.2 — Start timing&#10;&#10;Ready to Drive only via the &#x27;Go&#x27; signal from the Remote Stop Control Box, after &gt;=5 s in Ready. Run must start within 30 s of Go or it is DNF.&#10;&#10;Maps to: Actuator Power Supply: RSS Control Box &quot;GO&quot; signal · Aux Panel GO/E-STOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="3150" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_29" value="DD.3.1.5 — Staging timing&#10;&#10;Must enter Driverless System Ready within 1 minute of staging or the team may be sent back.&#10;&#10;Maps to: Monoboard State Machine / mission-selection timing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="3320" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_30" value="DD.2.1.3 — Unsafe Stop&#10;&#10;DQ if the car does not stop in the specified area OR does not reach Finished within 30 s of stopping.&#10;&#10;Maps to: EBS Control · DSSI Emergency state (needs DSSI block, see ELECTRICAL column)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5ea;strokeColor=#128f61;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-930" y="3490" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_31" value="IN.3.1-&gt;IN.3.2-&gt;EBS — Inspection sequence&#10;&#10;Technical Inspection (IN.3.1) -&gt; Driverless Inspection (IN.3.2) -&gt; Emergency Brake System Test. All three required to operate in Driverless Mode (DI.1.1).&#10;&#10;Maps to: Whole system: Software Pipeline + HW Setup + Actuator Power Supply — gates whether Driverless Mode may run at all" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d9f2;strokeColor=#5c3a7d;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-520" y="2130" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_32" value="DI.2 — EBS Test&#10;&#10;Accelerate to 40 km/h minimum within 20 m, stop within 8.5 m from remote stop actuation. Performed after the rest of Technical Inspection. Wet conditions may be scaled by officials.&#10;&#10;Maps to: ABS/EBS · Actuator Power Supply: EBS Control / EBS Actuator Supply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d9f2;strokeColor=#5c3a7d;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-520" y="2300" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_33" value="DO.1.3 — Inspection Mission&#10;&#10;Car supported off ground, wheels removed. Slowly spin drivetrain, slowly sine-sweep steering, transition to Finished after 25-30 s.&#10;&#10;Maps to: Monoboard State Machine (-&gt; Finished transition) · Motor / Steering actuator (spin / sine-sweep)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d9f2;strokeColor=#5c3a7d;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-520" y="2470" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_card_34" value="bring_to_inspection — Docs required at inspection&#10;&#10;Sensor data sheets; Documents proving sensors meet local legislation; Remote Stop remote control; Tools for driverless inspection; Copies of submitted Rules Questions and answers&#10;&#10;Maps to: Team documentation / submissions — not a physical system block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d9f2;strokeColor=#5c3a7d;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-520" y="2640" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_title_35" value="From Image — Design Notes&#10;(descriptive text pulled from your handwritten brain-dump photos, not from the official rules text)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="3700" width="1750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_36" value="(from image) — EBS&#10;&quot;Most technically challenging part&quot; — annotation under EBS in the mech brain dump" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="3760" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_37" value="(from image) — DSB&#10;&quot;Likely Reuse&quot; (+/-) — annotation under DSB in the mech brain dump" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="3900" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_38" value="(from image) — ASM&#10;&quot;Physical Mounting locations&quot; and &quot;Considering all software requirements&quot; — noted under Autonomous Sensor Mounting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="4040" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_39" value="(from image) — ASS&#10;&quot;Motor selection + Mounting&quot; and &quot;Steering column integration w/ motor&quot; — noted under Autonomous Steering System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="4180" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_40" value="(from image) — EBS + DBS&#10;&quot;PCB for watchdog?&quot; — open question noted under Brakes/EBS+DBS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="3760" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_41" value="(from image) — DBS / Regen&#10;&quot;Regen — reg torque values to motor is how some teams do it&quot; — noted under Regen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="3900" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_42" value="(from image) — RES (RSS)&#10;&quot;Safety loop addition w/ relay&quot; — noted under the RES/RSS box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-1340" y="4040" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_43" value="(from image) — Sensors / LiDAR&#10;&quot;Placement affects routing&quot; and &quot;Most teams either on nose cone or below RTM light&quot; — noted under Sensors/LiDAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
