        <mxCell id="apse8" edge="1" parent="1" source="aps_ebs_control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" target="aps_bypass_relay">
          <mxGeometry relative="1" as="geometry" />
