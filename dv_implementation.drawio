        <mxCell id="apse7" edge="1" parent="1" source="aps_driverless_sys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="aps_bypass_relay">
