        <mxCell id="wbs_1hEIRoDbOSdjLODKiPfq-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;br&gt;&lt;div align=&quot;center&quot;&gt;Responsibilities&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;1. Bring up: LiDAR&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;2.&amp;nbsp;Bring up: Camera&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;3.&amp;nbsp;Bring up: Jetson controller&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;4. Low level comms design (CAN, UART, SPI, ADC etc.)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;div align=&quot;left&quot;&gt;5. New state machine additions, and VCU (EV) firmware design&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;6. Spin / Actuation motor(s)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;7. Driverless Mission Indicator updates (dash display)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;8. Docker containerization&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
