        </mxCell>
        <mxCell id="rm_fi_41" value="(from image) — DBS / Regen&#10;&quot;Regen — reg torque values to motor is how some teams do it&quot; — noted under Regen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
