        </mxCell>
        <mxCell id="rm_fi_44" value="(from image) — TSA button&#10;&quot;need DSMS iirc&quot; — blue annotation next to the TSA button under Controls &amp; Indicators" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-930" y="3900" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_fi_45" value="(from image) — Driverless Controller Integration&#10;&quot;Jetson Orin AGX 64GB (ideally)&quot;; &quot;Just mount to hit on car year 1&quot;; &quot;PCB and enclosure year 2 (for CAN and other I/O)&quot;; &quot;Camera -&gt; Automotive Ethernet&quot;; &quot;LiDAR -&gt; figure out&quot; (marked in red = unresolved)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="-930" y="4040" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rm_legend_46" value="Legend: MECH (blue) = DT.2.x/DT.3.x mechanical requirements  |  ELEC (orange) = DT.1.x/DT.4/DO.2.2 electrical requirements  |  SOFTWARE (green) = DO.1.x/DD.x software requirements  |  GATING (purple) = inspection/test rules  |  yellow dashed = pulled from your handwritten images, not the rulebook.&#10;Abbreviations: ABS=Autonomous Braking System, ASM=Autonomous Sensor Mounting, ASS=Autonomous Steering System, DSMS=Driverless System Master Switch, DSSI=Driverless System Status Indicators, RSS=Remote Stop System, EBS=Emergency Brake System, DSB=Driverless System Brake." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="-1750" y="4350" width="1750" height="90" as="geometry" />
