        <mxCell id="rm_fi_45" value="(from image) — Driverless Controller Integration&#10;&quot;Jetson Orin AGX 64GB (ideally)&quot;; &quot;Just mount to hit on car year 1&quot;; &quot;PCB and enclosure year 2 (for CAN and other I/O)&quot;; &quot;Camera -&gt; Automotive Ethernet&quot;; &quot;LiDAR -&gt; figure out&quot; (marked in red = unresolved)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
