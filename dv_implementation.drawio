        <mxCell id="apse6" edge="1" parent="1" source="aps_glv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" target="aps_bypass_relay">
          <mxGeometry relative="1" as="geometry" />
