        <mxCell id="apse9" edge="1" parent="1" source="aps_bypass_relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cc0000;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="aps_dsms_relay">
          <mxGeometry relative="1" as="geometry" />
