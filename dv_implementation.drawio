        <mxCell id="rm_fi_44" value="(from image) — TSA button&#10;&quot;need DSMS iirc&quot; — blue annotation next to the TSA button under Controls &amp; Indicators" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
